@keyframes ydDraw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
@keyframes ydFade{from{opacity:0}to{opacity:1}}
@keyframes ydDonut{from{stroke-dasharray:0 100}}
@keyframes ydFloat{0%,100%{transform:translate(0,0)}50%{transform:translate(22px,-16px)}}
@keyframes ydPing{0%{transform:scale(.7);opacity:.9}100%{transform:scale(2.6);opacity:0}}
@keyframes ydRise{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:none}}
@keyframes ydSlide{from{opacity:0;transform:translateX(-14px)}to{opacity:1;transform:none}}
@keyframes ydGrid{from{background-position:0 0}to{background-position:44px 44px}}
.yd{display:flex;flex-direction:column;gap:18px}
.yd>*{animation:ydRise .7s cubic-bezier(.2,.8,.2,1) both}
.yd>*:nth-child(2){animation-delay:.08s}.yd>*:nth-child(3){animation-delay:.16s}.yd>*:nth-child(4){animation-delay:.24s}.yd>*:nth-child(5){animation-delay:.32s}
.yd-hero{position:relative;overflow:hidden;border-radius:26px;padding:26px;color:#fff;background:linear-gradient(135deg,#0d1022 0%,#1a1f3d 50%,#3b2a08 100%);box-shadow:0 26px 60px rgba(18,20,48,.35)}
.yd-hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:44px 44px;animation:ydGrid 6s linear infinite;mask-image:linear-gradient(180deg,#000,transparent 85%);-webkit-mask-image:linear-gradient(180deg,#000,transparent 85%)}
.yd-orb{position:absolute;border-radius:50%;filter:blur(46px);opacity:.55;animation:ydFloat 10s ease-in-out infinite;pointer-events:none}
.yd-hero>*:not(.yd-orb){position:relative}
.yd .yd-title{font-size:26px;font-weight:800;margin:0;letter-spacing:-.4px;background:linear-gradient(90deg,#fff,#f3d37a,#fff);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:ylSheen 6s linear infinite}
.yd-live{display:inline-flex;align-items:center;gap:8px;font-size:12px;color:#cfd6ee}
.yd-dot{position:relative;width:9px;height:9px;border-radius:50%;background:#34d399}
.yd-dot::after{content:"";position:absolute;inset:0;border-radius:50%;background:#34d399;animation:ydPing 1.8s ease-out infinite}
.yd-btn{border:1px solid rgba(255,255,255,.25)!important;background:rgba(255,255,255,.08)!important;color:#fff!important;backdrop-filter:blur(8px);box-shadow:none!important;border-radius:12px;padding:8px 14px;font-weight:700;font-size:13px;cursor:pointer}
.yd-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-top:22px}
.yd-kpi{border-radius:18px;padding:16px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(10px);animation:ydRise .7s cubic-bezier(.2,.8,.2,1) both;transition:transform .3s}
.yd-kpi:hover{transform:translateY(-4px)}
.yd-kpi small{display:block;font-size:11px;letter-spacing:.6px;text-transform:uppercase;color:#aab3d6}
.yd-kpi b{display:block;font-size:30px;font-weight:800;margin:4px 0 2px;color:#fff}
.yd-grid2{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:18px}
@media (max-width:860px){.yd-grid2{grid-template-columns:1fr}}
.yd-card{background:var(--bg,#f4f6fa);border-radius:22px;padding:20px;box-shadow:8px 8px 18px rgba(163,177,198,.45),-8px -8px 18px rgba(255,255,255,.9)}
.yd-h{display:flex;justify-content:space-between;align-items:baseline;margin:0 0 12px;font-size:14px;font-weight:800;color:#2b2f3a}
.yd-h small{font-weight:600;color:#8a93a3;font-size:12px}
.yd-line{stroke-dasharray:1;stroke-dashoffset:1;animation:ydDraw 1.6s cubic-bezier(.2,.8,.2,1) .25s forwards}
.yd-area{opacity:0;animation:ydFade 1.2s ease .9s forwards}
.yd-seg{animation:ydDonut 1.2s cubic-bezier(.2,.8,.2,1) both}
.yd-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px}
.yd-tile{display:block;text-decoration:none;color:inherit;border-radius:18px;padding:14px;background:var(--bg,#f4f6fa);box-shadow:6px 6px 14px rgba(163,177,198,.45),-6px -6px 14px rgba(255,255,255,.9);transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s;animation:ydRise .6s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i,0) * 45ms)}
.yd-tile:hover{transform:translateY(-6px);box-shadow:10px 14px 26px rgba(184,134,11,.22),-6px -6px 14px rgba(255,255,255,.9)}
.yd-tile:active{transform:scale(.97)}
.yd-tile .n{font-size:22px;font-weight:800;color:#b8860b}
.yd-chip{display:inline-block;font-size:11px;font-weight:700;color:#1b6b3a;background:#e7f6ec;border-radius:20px;padding:2px 8px}
.yd-feed a{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;padding:9px 6px;border-bottom:1px solid rgba(163,177,198,.25);animation:ydSlide .5s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i,0) * 50ms);transition:background .2s,transform .2s;border-radius:10px}
.yd-feed a:hover{background:rgba(184,134,11,.08);transform:translateX(4px)}
.yd-tag{font-size:11px;font-weight:800;color:#8a6410;background:rgba(184,134,11,.12);border-radius:8px;padding:3px 8px;white-space:nowrap}
.yd-tip{position:absolute;transform:translate(-50%,-110%);background:#14172b;color:#fff;border-radius:10px;padding:6px 10px;font-size:12px;white-space:nowrap;pointer-events:none;box-shadow:0 8px 20px rgba(0,0,0,.25)}
@media (prefers-reduced-motion:reduce){.yd>*,.yd-orb,.yd-hero::before,.yd-title,.yd-dot::after,.yd-kpi,.yd-line,.yd-area,.yd-seg,.yd-tile,.yd-feed a{animation:none!important}.yd-line{stroke-dashoffset:0}.yd-area{opacity:1}}
